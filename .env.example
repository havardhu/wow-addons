# Game folders per edition, as one JSON object. Use / or \\ in paths.
# The key must match a top-level folder in this repo (e.g. forever/).
WOW_EDITIONS={"forever": "C:/Program Files (x86)/World of Warcraft/_forever_", "retail": "C:/Program Files (x86)/World of Warcraft/_retail_", "classic": "C:/Program Files (x86)/World of Warcraft/_classic_"}
